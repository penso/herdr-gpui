{
  "name": "herdrui-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "herdrui.dev", "custom_domain": true },
    { "pattern": "www.herdrui.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
