# Agent notices: the toast over the terminal and the system notification.
# Their titles and bodies come from the daemon; these are the app's own.

# The title of a notice the daemon sent without one.
notifications-untitled = Notification

# QA > Notifications previews a toast or a system notification of each kind.
notifications-preview-attention = Needs attention
notifications-preview-attention-body = QA preview: an agent is waiting for your input.
notifications-preview-finished = Finished
notifications-preview-finished-body = QA preview: an agent has completed its task.
notifications-preview-update = Update installed
notifications-preview-update-body = QA preview only. No update was installed.
notifications-preview-custom = Custom notification
notifications-preview-custom-body = QA preview: a custom notification message.
