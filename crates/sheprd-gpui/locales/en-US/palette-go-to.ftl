# The command palette's Go To rows: what kind of place each row is, an
# agent's status, the agent filter, and the preview of the selected row.
# Workspace, tab, pane, and agent names are data.

# The badge at the end of a row, naming what the row goes to.
palette-go-to-workspace = Workspace
palette-go-to-tab = Tab
palette-go-to-terminal = Terminal
palette-go-to-note = Note
# An agent's status, as its row's badge and the preview show it.
palette-go-to-blocked = blocked
palette-go-to-done = done
palette-go-to-working = working
palette-go-to-idle = idle
# Searched for, never shown: what every agent row is.
palette-go-to-agent = agent
# The agent filter's choices (Alt with a letter picks one).
palette-go-to-filter-all = All agents
palette-go-to-filter-blocked = Blocked
palette-go-to-filter-working = Working
palette-go-to-filter-idle = Idle
palette-go-to-filter-done = Done
# The preview's facts about a row whose screen is not on hand.
palette-go-to-fact-status = Status
palette-go-to-fact-directory = Directory
palette-go-to-fact-workspace = Workspace
palette-go-to-fact-tab = Tab
palette-go-to-fact-branch = Branch
palette-go-to-fact-path = Path
palette-go-to-fact-tabs = Tabs
# Over a pane's last frame; $age is how long ago, such as "3 min ago".
palette-go-to-last-seen = Last seen { $age }
palette-go-to-connection-changed = The selected connection changed. Reopen the palette.
