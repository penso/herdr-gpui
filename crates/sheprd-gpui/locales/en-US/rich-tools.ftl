# Labels above a tool's retained source or reported edits in rich conversations.
rich-tools-terminal = Terminal
rich-tools-source = Source
rich-tools-command = Command
rich-tools-arguments = Arguments
rich-tools-output = Output
rich-tools-reported-patch = Reported patch · supplied hunks
rich-tools-no-changes = No changes in the supplied text.
# $kind is what the call does, such as Run; $label is the agent's title for it.
rich-tools-details = { $kind }: { $label }

# $path is the filename reported by the agent. The preview compares only the
# supplied text; it does not read files or reconstruct a missing previous file.
rich-tools-provided-text = { $path } · provided text
rich-tools-diff-preview-limit = { $path } · provided text exceeds diff preview limits
rich-tools-written-content = { $path } · written content; previous content unavailable
