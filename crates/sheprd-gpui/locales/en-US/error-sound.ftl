# Why a notification sound did not play or its settings did not load.
# $error is the audio library's own text.

error-sound-cancelled = Audio playback cancelled
error-sound-config-size = Sound configuration exceeds 1 MiB
error-sound-decode = Could not decode MP3 sound: { $error }
error-sound-device = Could not open audio output: { $error }
error-sound-file = Could not read sound file { $path }: { $error }
error-sound-file-size = Sound must be a regular file of at most 16 MiB
error-sound-stream = Audio output failed: { $error }
error-sound-timeout = Audio playback timed out
