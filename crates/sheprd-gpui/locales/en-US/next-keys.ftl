# The panel listing the keys that can follow the prefix, shown after a pause.

next-keys-label = Keys after the prefix
# Rows standing for a run of numbered commands, such as keys 1 to 9.
next-keys-focus-agent = Focus agent by number
next-keys-focus-tab = Focus tab by number
next-keys-focus-workspace = Focus workspace by number
# $count is how many keys did not fit in the window.
next-keys-more = { $count } more in Keyboard Shortcuts
# $prefix is the prefix key, as a shortcut such as ctrl-b.
next-keys-hint = { $prefix } again sends it to the pane, Esc cancels
