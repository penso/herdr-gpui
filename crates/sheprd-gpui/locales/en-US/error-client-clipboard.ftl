# Failures sending an image from the clipboard to a pane through the daemon.

error-client-clipboard-busy = a clipboard image upload is already reserved or in progress
error-client-clipboard-cancelled = clipboard image upload cancelled
error-client-clipboard-input-target = semantic input fallback requires a pane or popup target
error-client-clipboard-preparation-timeout = clipboard image preparation timed out; reservation skipped
error-client-clipboard-write-timeout = clipboard image write timed out; reconnect required
