# The Git popup's commit dialog.

git-commit-note = Stages every change in the checkout, then commits.
git-commit-note-staged = Commits what is staged and leaves the other changes as they are.
# The choice to commit only what is staged; $count is how many files are.
git-commit-only-staged = { $count ->
    [one] Only the staged file
   *[other] Only the { $count } staged files
}
git-commit-title = Commit
git-commit-cancel = Cancel
git-commit-submit = Commit
