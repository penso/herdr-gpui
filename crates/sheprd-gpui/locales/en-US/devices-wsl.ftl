devices-wsl-added = Added
devices-wsl-intro = Herdr is checked inside the distribution and its server started if it is installed. Install Herdr there first if it is not.
devices-wsl-session = Session (optional)
devices-wsl-checking = Checking Herdr in { $distro }…
devices-wsl-add = Add distribution
devices-wsl-add-checking = Checking…
devices-wsl-remove-failed = Remove { $distro }: { $error }
devices-wsl-remove-title = Remove distribution
devices-wsl-remove-note = Remove { $distro } from this computer's devices? Herdr keeps running inside it.
devices-wsl-cancel = Cancel
devices-wsl-remove = Remove
devices-wsl-save-failed = Save { $distro }: { $error }
devices-wsl-missing = Herdr was not found in { $distro }. Install it inside the distribution, then add it again.
devices-wsl-outdated = The Herdr in { $distro } is too old for this app. Update it inside the distribution, then add it again.
devices-wsl-no-answer = { $distro } did not answer.
devices-wsl-check-failed = Check { $distro }: { $error }
