# WSL distributions as devices: Add Device's WSL form, and removing one.
# $distro is a distribution's name, such as Ubuntu.

devices-wsl-pick = Pick a distribution.
devices-wsl-already-added = { $distro } is already a device.
devices-wsl-looking = Looking for distributions…
devices-wsl-list-failed = WSL did not list its distributions: { $error }
devices-wsl-none = No WSL distributions are installed. Install one with `wsl --install`, then open this dialog again.
