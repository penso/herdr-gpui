# The VS Code tab: VS Code's server shown as a page, and what the tab says
# until it is there. VS Code is a product name.

browser-vscode-still-finding = Still looking for VS Code
browser-vscode-set-server = Set the VS Code server in Settings
browser-vscode-unsupported = This build cannot show pages in the window.
browser-vscode-no-server = Set the VS Code server in Settings to show VS Code here.
browser-vscode-finding = Looking for VS Code…
browser-vscode-missing = VS Code is not installed. Install it, or set the address of a server you run in Settings.
browser-vscode-starting = Starting VS Code… (the first run downloads it)
# $commit is the first characters of the server's version commit.
browser-vscode-loading = Loading VS Code { $commit }…
browser-vscode-connecting = Connecting to VS Code…
browser-vscode-unreachable = Cannot reach the VS Code server
browser-vscode-retrying = Retrying…

# Asking to accept VS Code server's license before the app starts it.
browser-vscode-start = Start VS Code
browser-vscode-license = License Terms
browser-vscode-privacy = Privacy Statement
browser-vscode-accept = Accept and start
