# Settings > Notifications, beyond the rows search finds (settings.ftl).

## Groups on the page.

settings-notifications-section-delivery = Delivery
settings-notifications-section-toasts = In-app toasts
settings-notifications-section-sound = Sound

## Rows.

# Where agent notifications go: nowhere, Herdr's in-app toasts, the
# terminal, or the system's notifications.
settings-notifications-delivery-off = Off
settings-notifications-delivery-herdr = Herdr
settings-notifications-delivery-terminal = Terminal
settings-notifications-delivery-system = System
settings-notifications-finished-description = Off drops the notice at the end of each agent turn, in-app and from the system; “needs attention” still shows.
settings-notifications-position-description = Controls show effective values; a managed-file override still takes precedence.
settings-notifications-delay-description = Wait before a toast appears, so quick turns stay quiet. Controls show effective values; a managed-file override still takes precedence.
settings-notifications-delay-reset = Reset
settings-notifications-sound-description = Uses Herdr's sound paths and per-agent overrides. Missing custom sounds fall back to bundled sounds.
settings-notifications-sound-description-no-window = Uses Herdr's sound paths and per-agent overrides. Missing custom sounds fall back to bundled sounds. Open a main Herdr window to preview audio.
settings-notifications-sound-test = Test
