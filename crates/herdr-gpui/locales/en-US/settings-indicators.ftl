# Settings > Indicators: the status icon sets, as cards to pick from. The
# rows' titles are in settings.ftl.

## The statuses each card previews, under its marks.

settings-indicators-status-working = working
settings-indicators-status-blocked = blocked
settings-indicators-status-done = done
settings-indicators-status-idle = idle
settings-indicators-status-unknown = unknown

## Each set's name, then one line on what sets it apart.

settings-indicators-set-dots = Dots
settings-indicators-set-dots-description = Small dots; a ring with a turning arc while working.
settings-indicators-set-solid = Solid
settings-indicators-set-solid-description = Filled discs with a cut-out mark; a crescent when idle.
settings-indicators-set-outline = Outline
settings-indicators-set-outline-description = The same marks in outline, with an open arc spinning.
settings-indicators-set-tiles = Tiles
settings-indicators-set-tiles-description = Each mark on a tile tinted with its status color.
settings-indicators-set-wave = Wave
settings-indicators-set-wave-description = Superset's wave grid; every status drawn in its cells.
settings-indicators-set-braille = Braille
settings-indicators-set-braille-description = Braille cells; blocked fills and empties dot by dot.
settings-indicators-set-orca = Orca
settings-indicators-set-orca-description = Orca's stepping ring, question bubble, and ringed check.
