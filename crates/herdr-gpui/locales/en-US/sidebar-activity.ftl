# The activity bar: the icon column at the window's edge that picks what the
# window shows. Each name is its button's tooltip and the title over the
# sidebar, which shows it in capitals.

sidebar-activity-bar = Activity
sidebar-activity-overview = Overview
sidebar-activity-workspaces = Workspaces
sidebar-activity-pull-requests = Pull requests
sidebar-activity-issues = Issues
sidebar-activity-security = Security
sidebar-activity-automations = Automations
sidebar-activity-usage = Usage
sidebar-activity-settings = Settings
# A screen reader's name for a button with a count: $label is the section,
# $count how many items it holds.
sidebar-activity-spoken = { $label }, { $count }
sidebar-activity-spoken-new = { $label }, { $count }, new activity
