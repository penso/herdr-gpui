open-checkout-cancel = Cancel
# Names the request in an error, as "Open workspace: <error>".
open-checkout-operation = Open workspace
open-checkout-busy = Open link: close the open dialog first
open-checkout-unavailable = Open link: this computer's Herdr is not available
open-checkout-disconnected = Open link: not connected to this computer's Herdr
