# Editing a command's shortcuts from the Keyboard Shortcuts page.

shortcut-editor-save-failed = Save keyboard shortcut: { $error }
shortcut-editor-save = Save
shortcut-editor-unbind = Unbind
shortcut-editor-reset = Reset
# $command is the command's name, such as Split Right.
shortcut-editor-title = Edit { $command }
# Key names stay as typed in the config file: ctrl, shift, alt, cmd.
shortcut-editor-hint = Type key names with modifiers, e.g. ctrl-shift-t. Separate alternatives with spaces.
shortcut-editor-note = Save replaces this command's shortcuts, including daemon chords. Reset restores inherited defaults.
# The empty field's placeholder. $example is a shortcut as the config file
# writes it, such as ctrl-shift-t.
shortcut-editor-placeholder = e.g. { $example }
shortcut-editor-cancel = Cancel
shortcut-editor-saving = Saving…
