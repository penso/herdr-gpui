# Why a link to a folder could not be opened. $path is the folder.

error-link-unreadable = { $path } could not be read
error-link-not-folder = { $path } is not a folder
error-link-not-checkout = { $path } is not a Git checkout or worktree
# Only on Windows, for a path on another computer's share.
error-link-remote = { $path } is on another computer
