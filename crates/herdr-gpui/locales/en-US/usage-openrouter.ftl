# OpenRouter's plan usage, in its usage panel.

## Setup: how to find each value the provider reads. Setting names,
## environment variables, URLs, cookie and header names, and the
## service's own menu paths stay as written.

usage-openrouter-setting-api-key = An OpenRouter API key (sk-or-v1-…) from https://openrouter.ai/settings/keys. A Management API key also works and adds the last 30 days of activity.
usage-openrouter-setting-management-api-key = Optional Management API key from https://openrouter.ai/settings/management-keys, used only for the last 30 days of account activity.
usage-openrouter-setting-base-url = Optional HTTPS API URL for a proxy. Defaults to https://openrouter.ai/api/v1.
usage-openrouter-setting-http-referer = Optional client URL sent as the HTTP-Referer header.
usage-openrouter-setting-x-title = Optional client title sent as the X-Title header. Defaults to Herdr.

## The report: the key's spending cap and spend, the account's prepaid
## credits, and, with a Management API key, the last 30 days of activity.
## The cap's reset window (such as monthly) stays as OpenRouter sends it.

usage-openrouter-credits = Credits
# The plan line of a free-tier key.
usage-openrouter-free-tier = Free tier
usage-openrouter-last-30-days = Last 30 days
usage-openrouter-spend = Spend
usage-openrouter-requests = Requests
usage-openrouter-tokens = Tokens
# How many models the account used in the last 30 days.
usage-openrouter-models = Models
# A window: the key's spending cap, when it names no daily, weekly, or
# monthly reset.
usage-openrouter-api-key-limit = API key limit
usage-openrouter-spending-cap = Spending cap
# The spending cap of a key without one.
usage-openrouter-no-limit = No limit configured
usage-openrouter-cap-remaining = Cap remaining
usage-openrouter-key-used = Key used
usage-openrouter-reset-window = Reset window
usage-openrouter-today = Today
usage-openrouter-this-week = This week
usage-openrouter-this-month = This month
# A section's title: the key's cap and spend.
usage-openrouter-api-key = API key
