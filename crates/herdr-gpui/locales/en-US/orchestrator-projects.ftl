# The menu in a section's search row that narrows the list to some of the
# projects it holds. Project names are shown as they are.

# The menu's first row, and its control's text while every project is listed.
orchestrator-projects-all = All projects
# The control's text while several projects are picked.
orchestrator-projects-count = { $count } projects
# A browsed Azure DevOps repository's button that stops listing it.
orchestrator-projects-remove = Stop listing { $repository }
