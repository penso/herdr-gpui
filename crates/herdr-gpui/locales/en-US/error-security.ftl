# Why the Security section could not read a repository's alerts, reports,
# or an item's page from GitHub.

# $error is the JSON parser's own text.
error-security-json = Cannot read GitHub's alerts listing: { $error }
error-security-output = GitHub's answer had no repository in it
# Restored from the cache, which held no read of this repository yet.
error-security-unread = Not read yet
