# How tab strips draw their tabs (View > Tab Layout, Settings > Tabs & panes).

tab-layout-classic = Classic
tab-layout-pills = Pills
tab-layout-outline = Outline
tab-layout-underline = Underline
tab-layout-cards = Cards
tab-layout-curved = Curved
tab-layout-compact = Compact

# The tooltip standing in for a tab's title when the tab face hides it;
# $label is the tab's name.
tab-layout-muted-hint = { $label } (notifications muted)
# The close button on a tab, for screen readers.
tab-layout-close = Close tab
