# The status bar along the window's foot.

status-bar-label = Status bar
# The connection to the Herdr daemon, shown while it is not simply
# connected. "Herdr server" is the daemon.
status-bar-connecting = Connecting...
status-bar-starting-daemon = Starting Herdr server...
status-bar-awaiting-snapshot = Connected; waiting for snapshot
status-bar-connected = Connected
status-bar-disconnected = Disconnected
status-bar-detached = Detached (daemon still running)
# $status is one of the above, $error what went wrong.
status-bar-status-error = { $status }: { $error }
# Pane resize mode, which has no control on screen; keep the key names.
status-bar-resize = Resize
status-bar-resize-keys = h j k l or arrows resize, Esc ends
status-bar-theme = Theme
status-bar-shortcuts = Shortcuts
status-bar-report-issue = Report issue
status-bar-update-available = Update available
# A screen reader's name for the version button; $version is the app's.
status-bar-version = Version { $version }
# The focused agent's model; $model is the agent's own name for it.
status-bar-model = Model { $model }
status-bar-change-model = Change model
# The keep-awake cup: its name, and its tooltip while on and off. A
# right-click holds it until every agent finishes its work.
status-bar-awake-display = Keep the display awake
status-bar-awake-system = Keep the system awake
status-bar-awake-until-agents = until agents finish
status-bar-awake-display-until-agents = Keeping the display awake until agents finish
status-bar-awake-system-until-agents = Keeping the system awake until agents finish
status-bar-awake-display-on = Keeping the display awake · Right-click: until agents finish
status-bar-awake-system-on = Keeping the system awake · Right-click: until agents finish
status-bar-awake-display-off = Keep the display awake · Right-click: until agents finish
status-bar-awake-system-off = Keep the system awake · Right-click: until agents finish
