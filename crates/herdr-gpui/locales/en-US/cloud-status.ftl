# The line under a cloud machine's progress bar while it is made, in the
# device picker, Settings > Cloud devices, and a fan-out's dispatch.

# $provider is the provider's name, such as Daytona.
cloud-status-contacting = Contacting { $provider }…
cloud-status-creating = Creating…
cloud-status-connecting = Connecting…
cloud-status-starting = Starting…
# $status is the provider's own word for where the build is, such as pending.
cloud-status-building = Building ({ $status })…
cloud-status-checking-herdr = Checking for Herdr…
# $progress is a cloud-status-image-step message or the builder's own output.
cloud-status-image = Building the image: { $progress }
cloud-status-installing-herdr = Installing Herdr…
# A sandbox image build's step; $status is the builder's own output.
cloud-status-image-step = Step { $step } of { $total }: { $status }
