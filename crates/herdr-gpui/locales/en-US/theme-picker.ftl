# The color scheme picker the menu opens. Theme names are data.

theme-picker-title = Color Scheme
theme-picker-close = Close
theme-picker-search = Search themes...
# How many themes match the search, of all there are.
theme-picker-count = { $total ->
    [one] { $shown } of { $total } theme
   *[other] { $shown } of { $total } themes
}
theme-picker-empty = No matching themes. Try a shorter search.
# Beside the theme the window shows now.
theme-picker-current = Current
theme-picker-saving = Saving theme... Please wait.
theme-picker-loading = Loading theme... Esc to cancel.
theme-picker-hint = Hover or Up / Down to preview. Enter or click a theme to save. Star a theme to keep it at the top.
theme-picker-star = Star theme
theme-picker-unstar = Unstar theme
theme-picker-favorites-failed = Could not save favorite themes: { $error }
