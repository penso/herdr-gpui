# Zed's plan usage, in its usage panel.

## Setup: how to find each value the provider reads. Setting names,
## environment variables, URLs, cookie and header names, and the
## service's own menu paths stay as written.

usage-zed-setting-cookie = The zed.dev browser session, for token spend. Sign in at https://zed.dev in your browser (signing in inside the editor is not enough), open Developer Tools → Application → Cookies → https://zed.dev, copy the zed.session cookie, and paste it as "zed.session=value".

## The report: edit predictions, token spend, and the billing period. Plan
## names (such as Zed Pro) stay as Zed names them.

usage-zed-plan = Plan
usage-zed-edit-predictions = Edit predictions
# Edit predictions used of the plan's allowance; $used and $limit are
# counts, such as 30 and 120.
usage-zed-used-of = { $used } of { $limit }
# Edit predictions used on a plan without a limit; $used is a count.
usage-zed-used-unlimited = { $used } used · Unlimited
usage-zed-billing = Billing
usage-zed-overdue-invoices = Overdue invoices
usage-zed-token-spend = Token spend
usage-zed-current-billing-period = Current billing period
usage-zed-spent = Spent
usage-zed-spend-limit = Spend limit
# The spend limit, when Zed does not report one.
usage-zed-not-reported = Not reported
usage-zed-remaining-budget = Remaining budget
