# The command palette's own text. Its rows name commands (commands.ftl) and
# things from the daemon and the user, which are never translated.

palette-filter-all = All
palette-filter-navigation = Navigation
palette-filter-commands = Commands
palette-filter-projects = Projects
palette-filter-notes = Notes
# How many rows match the search, of all the palette lists.
palette-count = { $shown } of { $total }
palette-placeholder = Search workspaces, commands, agents, and projects...
# What a row of each kind is, after its shortcut.
palette-badge-command = GUI action
palette-badge-herdr-command = Herdr command
palette-badge-mod = Mod
palette-badge-project = Project
palette-not-on-screen = Not on screen. Press Enter to go there and watch it live.
palette-loading-projects = Loading local projects...
palette-no-results = No matching results. Try a shorter search.
palette-opening-project = Opening local project... Esc to dismiss.
# The footer's keys; keep the key symbols as they are.
palette-hints = ↑↓ / Tab / ⌃N ⌃P move · ⌃Tab filter · ↵ select · Esc close
palette-go-to-hints = ↑↓ / Tab / ⌃N ⌃P move · ⌃Tab filter · ⌥B/W/I/D/A status · ⌥P preview · ↵ select · Esc close
