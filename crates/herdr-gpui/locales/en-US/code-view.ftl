# Code tabs: a source file shown read-only, with its definitions listed as
# an outline. File text and definition names are never translated.

# The outline's heading; $count is how many definitions it lists.
code-view-outline-count = Outline · { $count }
code-view-outline = Outline
code-view-hide-outline = Hide Outline
code-view-open-in-editor = Open in Editor
code-view-reading = Reading file…
code-view-no-workspace = Open a workspace first
code-view-too-many-tabs = Too many tabs are open
# What each definition in the outline is.
code-view-kind-function = function
code-view-kind-method = method
code-view-kind-type = type
code-view-kind-module = module
code-view-kind-constant = constant
code-view-kind-implementation = impl
code-view-kind-macro = macro
