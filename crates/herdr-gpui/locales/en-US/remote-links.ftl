# A paired phone asking to reach another machine directly, so it keeps it
# while this computer sleeps. $phone is the phone's name, $host the
# machine's.

remote-links-ask-title = Pair { $phone } with { $host } too?
remote-links-ask-detail = { $phone } asks to reach { $host } directly, so it keeps it while this computer sleeps. Herdr UI starts remote control on { $host } if it is not running there.
remote-links-ask-deny = Not now
remote-links-ask-allow = Pair
