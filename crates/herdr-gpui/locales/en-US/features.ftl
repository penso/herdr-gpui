# The optional `[features]` flags, as Settings > General lists them.

features-acp-chats = ACP chats
features-acp-chats-description = Show herdr-acp chats as native chat views and offer new chats with the agents installed on the host. Off, chat panes keep their terminal and nothing looks for herdr-acp or agents.
features-qa-menu = QA menu
features-qa-menu-description = Add a QA menu for checking the app by hand: sample toasts and dialogs, update progress, sounds, a test notification, the badge, and slowed animations.
features-sidebar-hover-menu = Open space menus on hover
features-sidebar-hover-menu-description = Open a space's menu when the pointer rests on its sidebar row, without a right click. Moving the pointer anywhere but into that menu closes it again.
