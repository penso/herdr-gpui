# The strip of tabs over each group of panes, and what a group shows in
# place of a tab it cannot show. Tab names are the user's or the daemon's.

tab-strip-tabs = Tabs
tab-strip-new-tab = New tab
tab-strip-split = Split
tab-strip-actions = Tab actions
# A chat launcher's tooltip; $agent is the agent's name, such as Claude.
tab-strip-new-chat = New { $agent } chat
# On a tab dragged outside the window.
tab-strip-release-new-window = Release to open in a new window
# A tab another group shows, while it moves here.
tab-strip-opening = Opening…
tab-strip-show-here = Show Here
# A split group with no tabs. Keep "+" and "⋯": they are the strip's
# buttons.
tab-strip-no-tabs = No tabs
tab-strip-no-tabs-hint = Open a terminal tab with "+", or another kind of tab from the "⋯" menu.
tab-strip-nothing = Nothing to show.
# A muted tab's name for screen readers.
tab-strip-muted = { $label }, notifications muted
