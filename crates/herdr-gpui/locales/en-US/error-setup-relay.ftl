# Why a device setup's terminal relay failed.

error-setup-relay-closed = Herdr closed the setup before it finished. Start it again from Add Device.
error-setup-relay-connect = This setup is no longer waiting. Start it again from Add Device.
error-setup-relay-dir = { $path } is not a private folder of this user, so the setup cannot listen there.
error-setup-relay-frame = The setup terminal sent something unreadable.
error-setup-relay-terminal = The device setup needs a terminal.
