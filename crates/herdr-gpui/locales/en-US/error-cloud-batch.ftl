# Cloud machines an agent asked for from the command line.

# $provider is a cloud provider's name.
error-cloud-batch-not-offered = { $provider } machines cannot be created from the command line.
# $code is the setup script's exit code.
error-cloud-batch-setup-exited = The setup script exited { $code }.
# $output is what the setup script printed, kept as it is.
error-cloud-batch-setup-exited-output = The setup script exited { $code }: { $output }
error-cloud-batch-setup-signal = A signal ended the setup script.
error-cloud-batch-setup-signal-output = A signal ended the setup script: { $output }
