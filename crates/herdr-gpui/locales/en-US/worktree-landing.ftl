# The new worktree dialog's choice of what the checkout's first pane shows:
# its shell, or an agent started in it. Agent names are program names and
# stay untranslated.
worktree-landing-label = Opens in
worktree-landing-terminal = Terminal
worktree-landing-looking = Looking for agents…
# $agent is the agent's program name, such as claude; $error says why.
worktree-landing-failed = Could not start { $agent } in the new worktree: { $error }
